// Firebase configuration keys — example / template.
// Copy this file to Secrets.xcconfig and fill in real values from:
// Firebase console → Project settings → Your iOS app → GoogleService-Info.plist
//
// On CI: generate Config/Secrets.xcconfig from environment variables, e.g.:
//   FIREBASE_API_KEY=$FIREBASE_API_KEY
//   (one line per key, same format as below)

// API_KEY field from GoogleService-Info.plist
FIREBASE_API_KEY = YOUR_API_KEY

// GCM_SENDER_ID field (also called "Sender ID" in Cloud Messaging settings)
FIREBASE_GCM_SENDER_ID = YOUR_GCM_SENDER_ID

// PROJECT_ID field
FIREBASE_PROJECT_ID = your-project-id

// STORAGE_BUCKET field
FIREBASE_STORAGE_BUCKET = your-project-id.firebasestorage.app

// GOOGLE_APP_ID field (format: 1:SENDER_ID:ios:HEX)
FIREBASE_GOOGLE_APP_ID = 1:YOUR_GCM_SENDER_ID:ios:YOUR_HEX_ID

// Required by the Crashlytics run script to locate the app without a GoogleService-Info.plist
GOOGLE_APP_ID = $(FIREBASE_GOOGLE_APP_ID)
